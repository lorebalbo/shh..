# Xcode
#
# Xcode files/directories that should be ignored

build/
*.pbxproj
*.xcworkspace
xcuserdata/
DerivedData/
*.hmap
*.xccheckout
*.moved-aside
*.xcuserstate
*.xcscmblueprint

# CocoaPods
Pods/
*.xcworkspace

# Carthage
Carthage/Build/

# Swift Package Manager
.build/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon

# Other
*.swp
*~.nib

# XcodeGen specific
SHH.xcodeproj

# Benchmark datasets and reports (PRD-0004 / PRD-0005)
build/benchmarks/
.cache/shh-benchmarks/
shh-benchmarks/

*.dmg
*.txt
# Python bytecode (e.g. from .claude/skills scripts)
__pycache__/
